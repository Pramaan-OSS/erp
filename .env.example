# The only value a person sets. Get it from your Pramaan account.
PRAMAAN_API_KEY=

# Local settings. Missing values are generated on first run by ./start
# and written back to this file. Keep .env private; never commit it.
LOCAL_DB_PASSWORD=
ERP_ADMIN_PASSWORD=
ERP_ENCRYPTION_KEY=
ERP_SITE_NAME=erp.localhost
ERP_LOCAL_PORT=18010
ERP_COMPOSE_PROJECT=

# Base URL of the Pramaan API. Leave empty to use the default.
# PRAMAAN_BASE_URL=

# Set to 1 to run the built-in local fixture instead of live Pramaan calls.
# PRAMAAN_FAKE=

# Optional features stay off until you configure them. Nothing below is
# needed for a first run.

# Bank feeds are not available yet. When they go live, connect a bank in
# Banking settings; no key belongs in this file.

# One sender identity for all outgoing mail.
PRAMAAN_EMAIL_FROM=ERP <noreply@updates.pramaan.one>

# Tax category used by every invoice payment link and checkout.
PRAMAAN_TAX_CATEGORY=digital_products
